{
  "manifest_version": 3,
  "name": "Honey Barrel by BAXUS",
  "version": "1.0",
  "description": "Compare bottle prices with BAXUS marketplace.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "webRequest"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "utils/libs/resemble.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "utils/matcher.js"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/*.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}