{
  "manifest_version": 3,
  "name": "Honey Barrel by BAXUS",
  "version": "1.0",
  "description": "Compare bottle prices with BAXUS marketplace.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/*.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}